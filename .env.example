# =============================================================================
# sub-web 构建环境变量模板（脱敏，可提交 Git）
#
# 使用：cp .env.example .env  →  将占位值改为你的真实配置  →  yarn build / docker build
# 说明：变量在「构建时」打进静态资源，改 .env 后须重新构建，仅重启容器无效。
# 隐私：勿提交 .env（已列入 .gitignore）；本文件与本地 .env 仅「值」不同，结构一致。
# 格式：推荐 KEY=value（等号两侧无空格、值一般不加引号），与 vite loadEnv 兼容。
# =============================================================================

# 项目主页链接（关于/跳转用，可保留默认）
VITE_PROJECT=https://github.com/CareyWang/sub-web

# Telegram 讨论群链接
VITE_BOT_LINK=https://t.me/subconverter_discuss

# subconverter 发布页（「前往项目仓库」等按钮）
VITE_BACKEND_RELEASE=https://github.com/tindy2013/subconverter/actions

# 远程配置 ini 样例 URL（进阶模式「配置示例」）
VITE_SUBCONVERTER_REMOTE_CONFIG=https://raw.githubusercontent.com/tindy2013/subconverter/master/base/config/example_external_config.ini

# subconverter 进阶文档链接
VITE_SUBCONVERTER_DOC_ADVANCED=https://github.com/tindy2013/subconverter/blob/master/README-cn.md#%E8%BF%9B%E9%98%B6%E9%93%BE%E6%8E%A5

# -----------------------------------------------------------------------------
# 部署路径（子路径 / NPM 反代，2026-05 新增）
# -----------------------------------------------------------------------------

# 前端资源与 Vue Router 的 base；NPM 反代 /subw/ 时填 /subw/（必须以 / 结尾）
# 根路径部署（直接占站点根）时填 /
VITE_BASE_PATH=/subw/

# -----------------------------------------------------------------------------
# subconverter 后端（构建进 DEFAULT_BACKEND，2026-05 调整）
# -----------------------------------------------------------------------------

# 默认 subconverter API「根地址」：HTTPS + 反代路径，勿带 /sub?（代码会拼接 /sub?）
# 填什么：浏览器能访问到的 API 前缀，例如 https://<公网域名>:<HTTPS端口>/subapi
# 勿填：内网 IP:25500（易 Mixed Content）、勿带末尾 /sub?
VITE_SUBCONVERTER_DEFAULT_BACKEND=https://nas.example.com:8443/subapi

# 进阶模式「后端地址」下拉第二项：本机/内网自建 subconverter 完整入口（含 /sub?）
# 不需要第二项时可留空或与上一项相同（相同则不会重复出现在下拉中）
VITE_BACKEND_OPTION_LOCAL=http://127.0.0.1:25500/sub?

# -----------------------------------------------------------------------------
# 其它第三方服务（按自建情况填写）
# -----------------------------------------------------------------------------

# 短链接生成 API
VITE_MYURLS_API=https://short.example.com/short

# 远程配置文本上传 API
VITE_CONFIG_UPLOAD_API=https://upload.example.com/upload

# -----------------------------------------------------------------------------
# 页面行为
# -----------------------------------------------------------------------------

# 是否用 localStorage 缓存表单（true/false）
VITE_USE_STORAGE=true

# 缓存 TTL（秒）
VITE_CACHE_TTL=86400
