# =============================================================================
# NAS / NPM 子路径部署模板（脱敏，可提交 Git）
#
# 选文件：
#   .env.default  → 根路径 + api.wcc.best，【必改】项为 0，复制即可 build
#   .env.example  → 本文件：/subw/ + 自建 subapi，须改【必改】项
#
# 使用：cp .env.example .env  →  只改【必改】→  其余按需改【可改】→  build
# 图例：【必改】 【可改】 【沿用默认·不必改】
# =============================================================================

# ── 【沿用默认·不必改】与 .env.default 相同 ────────────────────────────────

VITE_PROJECT=https://github.com/HouJia/sub-web
VITE_BOT_LINK=https://t.me/subconverter_discuss
VITE_BACKEND_RELEASE=https://github.com/HouJia/SubConverter-Extended
VITE_SUBCONVERTER_REMOTE_CONFIG=https://raw.githubusercontent.com/tindy2013/subconverter/master/base/config/example_external_config.ini
VITE_SUBCONVERTER_DOC_ADVANCED=https://github.com/tindy2013/subconverter/blob/master/README-cn.md#%E8%BF%9B%E9%98%B6%E9%93%BE%E6%8E%A5

# ── 【必改】NAS + NPM 部署（2 项，须换成你的真实值）────────────────────────

# 【必改】与 NPM location /subw/ 一致，必须以 / 结尾
VITE_BASE_PATH=/subw/

# 【必改】HTTPS 反代后的 subconverter API 根（勿带 /sub?、勿末尾 /）
# 示例：https://<公网域名>:<HTTPS端口>/subapi
VITE_SUBCONVERTER_DEFAULT_BACKEND=https://nas.example.com:8443/subapi

# ── 【可改】按需调整，有合理默认或可不启用 ─────────────────────────────────

# 【可改】进阶模式后端下拉第二项（本机 subconverter，须含 /sub?）；不需要可删
VITE_BACKEND_OPTION_LOCAL=http://127.0.0.1:25500/sub?

# 【可改】短链接；不用可删，或沿用 .env.default 的 suosuo.de
VITE_MYURLS_API=https://short.example.com/short

# 【可改】配置上传；不用可删
VITE_CONFIG_UPLOAD_API=https://upload.example.com/upload

# ── 【沿用默认·不必改】────────────────────────────────────────────────────

VITE_USE_STORAGE=true
VITE_CACHE_TTL=86400
